{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "version": "0.7.0",
  "description": "Zero-overhead, terminal-native local-LLM manager",
  "homepage": "https://github.com/llamastash/llamastash",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/llamastash/llamastash/releases/download/v0.7.0/llamastash-0.7.0-x86_64-pc-windows-msvc.zip",
      "hash": "55f1fa620774d50505a16c77cefce638682a860a8822923ba91d7e714d4fec34",
      "extract_dir": "llamastash-0.7.0-x86_64-pc-windows-msvc"
    }
  },
  "bin": "llamastash.exe",
  "post_install": [
    "Write-Host 'llamastash installed. Run `llamastash init` to set up models and llama-server.'"
  ],
  "checkver": {
    "github": "https://github.com/llamastash/llamastash"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/llamastash/llamastash/releases/download/v$version/llamastash-$version-x86_64-pc-windows-msvc.zip",
        "extract_dir": "llamastash-$version-x86_64-pc-windows-msvc"
      }
    },
    "hash": {
      "url": "$url.sha256",
      "regex": "^([a-fA-F0-9]{64})"
    }
  },
  "notes": [
    "First run: `llamastash init` walks through model + GPU detection.",
    "Then `llamastash` to launch the TUI, or `llamastash --help` for the CLI.",
    "AMD GPU detection on Windows is on the roadmap; CPU and Vulkan (discrete GPU) routing works today."
  ]
}
